    "glossary": {
      "prep": {
        "th": "PrEP — ยากินก่อนเสี่ยง ป้องกัน HIV เมื่อกินสม่ำเสมอ",
        "en": "PrEP — a daily pill that prevents HIV when taken consistently"
      },
      "pep": {
        "th": "PEP — ยากินหลังเสี่ยง ต้องเริ่มภายใน 72 ชั่วโมง",
        "en": "PEP — a pill taken after possible exposure, started within 72 hours"
      },
      "uu": {
        "th": "U=U — ตรวจไม่เจอ = ไม่ส่งต่อ เมื่อกดไวรัสได้สำเร็จ",
        "en": "U=U — Undetectable = Untransmittable when viral load is suppressed"
      },
      "art": {
        "th": "ART — ยาต้านไวรัสที่กินต่อเนื่องเพื่อคุมเชื้อ HIV",
        "en": "ART — antiretroviral medicine taken regularly to control HIV"
      },
      "hivst": {
        "th": "HIVST — ชุดตรวจ HIV ด้วยตัวเองที่บ้าน",
        "en": "HIVST — an HIV self-test you can use at home"
      },
      "rrttpr": {
        "th": "RRTTPR — แนวทางพาคนเข้าถึง ตรวจ รักษา และอยู่ในระบบ",
        "en": "RRTTPR — a model to Reach, Recruit, Test, Treat, Prevent & Retain"
      }
    },
